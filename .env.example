# URL aplikasi dan API lokal
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000

# Siapkan nilai ini sebelum menghubungkan Supabase/admin produksi
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ganti dengan nilai acak yang kuat saat autentikasi admin sudah diaktifkan
ADMIN_SESSION_SECRET=change-this-before-production
